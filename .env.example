# Database (Turso / libSQL). Leave unset locally to use data/idis.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin login at /admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=a-random-string-of-32-or-more-characters

# Cloudinary uploads (admin "Upload" buttons). Without the API key the
# buttons are hidden and image URLs can still be pasted.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=idis
